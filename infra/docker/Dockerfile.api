# ─── NestJS API — multi-stage Dockerfile ─────────────────────────────────────
# NFR-17: Versioned container images (production stage)
# NFR-02: Docker Compose on VPS
# NFR-18: One developer; human review required for security changes

# ─── Stage 1: base ────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
# pnpm version must match engines.pnpm in root package.json
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app

# ─── Stage 2: dependencies ────────────────────────────────────────────────────
FROM base AS deps
# Copy workspace manifests only — layer caches until manifests change
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile

# ─── Stage 3: development ─────────────────────────────────────────────────────
# Used by docker-compose.yml for local dev with hot reload
FROM deps AS development
COPY . .
EXPOSE 3001
CMD ["pnpm", "--filter", "@ktb/api", "dev"]

# ─── Stage 4: builder ─────────────────────────────────────────────────────────
FROM deps AS builder
COPY packages/tsconfig ./packages/tsconfig
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api
RUN pnpm --filter @ktb/shared-types build
RUN pnpm --filter @ktb/api build

# ─── Stage 5: production ──────────────────────────────────────────────────────
# Minimal production image — no dev tools or source files
FROM node:22-alpine AS production
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app

# Non-root user for security (NFR-08: least privilege)
RUN addgroup --system --gid 1001 ktb && \
    adduser --system --uid 1001 --ingroup ktb ktb

COPY --from=builder --chown=ktb:ktb /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=ktb:ktb /app/apps/api/package.json ./apps/api/
COPY --from=builder --chown=ktb:ktb /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder --chown=ktb:ktb /app/package.json ./
COPY --from=builder --chown=ktb:ktb /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=ktb:ktb /app/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile --prod

USER ktb
EXPOSE 3001
ENV NODE_ENV=production

# Health check matching docker-compose.yml
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:3001/api/health/live || exit 1

CMD ["node", "apps/api/dist/main.js"]
