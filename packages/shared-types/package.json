{
  "name": "@ktb/shared-types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types and enums shared between @ktb/api and @ktb/web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@ktb/tsconfig": "workspace:*",
    "typescript": "^5.6.3"
  }
}
