# ───────────────────────────────────────────────
# Environment variables
# ───────────────────────────────────────────────
# Real .env files are gitignored. Copy this file
# and fill in values for your environment.
#   cp .env.example .env
#
# NEVER commit actual secrets to version control.
# ───────────────────────────────────────────────

# ─── Environment ────────────────────────────────
NODE_ENV=development
# APP_ENV distinguishes ktb environments (dev | prod).
# NFR-04: Development and production only — no staging.
APP_ENV=development

# ─── NestJS API ─────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# Explicit opt-in for local development/test identity headers. Never enables them in production.
# The impersonated user must still hold current database permissions.
AUTH_ALLOW_DEV_HEADERS=false

# Public base URL used in generated links and CORS allow-list
API_BASE_URL=http://localhost:3001
# FR-IDENT-01: OTP rate-limit window in seconds
OTP_RATE_LIMIT_WINDOW_SECONDS=300
# Maximum OTP attempts per window
OTP_MAX_ATTEMPTS=5
# OTP expiry in seconds (short-lived per FR-IDENT-01)
OTP_EXPIRY_SECONDS=120

# Firebase phone ID-token audience. Public project identifier; no service-account key required.
FIREBASE_PROJECT_ID=indian-time-bank

# ─── Next.js Web Dashboard ───────────────────────
WEB_PORT=3000
# Must be prefixed NEXT_PUBLIC_ to be available in browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3001
# Firebase web app for dashboard sign-in. Leave empty to use the private QA code.
# Also needs FIREBASE_PROJECT_ID above and the dashboard domain in Firebase's authorized domains.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Server-side dashboard gateway; credentials are stored in HTTP-only session cookies.
API_INTERNAL_URL=http://127.0.0.1:3001
# Set the exact public origin when deploying behind a TLS reverse proxy.
# DASHBOARD_ORIGIN=https://admin.example.org
NEXT_PUBLIC_APP_ENV=development

# ─── PostgreSQL ──────────────────────────────────
# NFR-04: Never point dev config at a prod database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ktb_dev
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ktb_dev

# Full connection string (used by TypeORM / Prisma / pg)
DATABASE_URL=postgresql://ktb_dev:change_me_dev_password@localhost:5432/ktb_dev
# Set true for a database with a trusted TLS certificate.
DATABASE_SSL=false

# ─── JWT / Session ───────────────────────────────
# FR-IDENT-01: Short-lived tokens; rotate on recovery (FR-IDENT-04)
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ─── Redis (future — for job queues and session cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Mock OTP exposes the verification code. Enable ONLY for a private disposable QA server.
AUTH_ALLOW_MOCK_OTP=false

# ─── Background workers ──────────────────────────
# Run on every API instance; set to false only for one-off tasks
BACKGROUND_WORKERS_ENABLED=true
MATCHING_WORKER_INTERVAL_SECONDS=30
NOTIFICATION_WORKER_INTERVAL_SECONDS=15
# Service account JSON on one line, for sending push messages. Empty keeps messages queued
# until they expire. Keep it in a secret store and never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Rate limiting ───────────────────────────────
# Requests per minute, per client IP and route
RATE_LIMIT_PER_MINUTE=600
# Stricter limit for OTP, Firebase and refresh routes
AUTH_RATE_LIMIT_PER_MINUTE=30
# Proxies in front of the API (1 behind Nginx); 0 ignores X-Forwarded-For
TRUST_PROXY_HOPS=0
# Minutes one volunteer and one beneficiary can confirm in 30 days before a coordinator decides.
CREDIT_PAIR_MONTHLY_MINUTES=1200

# ─── SMS / OTP gateway ───────────────────────────
# FR-OFF-05: SMS notifications (push, SMS, optional WhatsApp)
SMS_PROVIDER=twilio           # twilio | aws-sns | msg91 | local-mock
SMS_FROM=+91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Staff panel second sign-in step (emailed code) ──────
# Coordinators and admins get a 6-digit code by email each time they sign in to the panel;
# until they enter it, that sign-in has member powers only. The phone app is unaffected.
# STAFF_SECOND_FACTOR=off turns this off (private QA only, never on a real server).
STAFF_SECOND_FACTOR=email     # email | off
EMAIL_PROVIDER=resend         # resend | local-mock (local-mock needs AUTH_ALLOW_MOCK_OTP=true, accepts 123456)
RESEND_API_KEY=
MAIL_FROM="Indian Time Bank <no-reply@indiantimebank.com>"
# First Super Admin, once after migrating (others are set in the panel member drawer):
#   docker compose -f docker-compose.server.yml run --rm api node apps/api/dist/database/set-staff-email.js +91XXXXXXXXXX you@example.org

# ─── WhatsApp (optional, consent-based — FR-OFF-05) ─────
WHATSAPP_PROVIDER=meta        # meta | local-mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── File / Document Storage ─────────────────────
# NFR-08: Encrypted sensitive storage for identity documents
STORAGE_PROVIDER=local        # local | s3 | gcs
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Monitoring / Logging ────────────────────────
# NFR-06: Redact private user data from logs
LOG_LEVEL=debug               # debug | info | warn | error
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ─── Docker Compose overrides ────────────────────
# COMPOSE_PROJECT_NAME is used by docker compose to namespace containers
COMPOSE_PROJECT_NAME=ktb_dev
