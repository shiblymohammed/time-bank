# ───────────────────────────────────────────────
# Environment variables
# ───────────────────────────────────────────────
# Real .env files are gitignored. Copy this file
# and fill in values for your environment.
#   cp .env.example .env
#
# NEVER commit actual secrets to version control.
# ───────────────────────────────────────────────

# ─── Environment ────────────────────────────────
NODE_ENV=development
# APP_ENV distinguishes ktb environments (dev | prod).
# NFR-04: Development and production only — no staging.
APP_ENV=development

# ─── NestJS API ─────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# Explicit opt-in for local development/test identity headers. Never enables them in production.
# The impersonated user must still hold current database permissions.
AUTH_ALLOW_DEV_HEADERS=false

# Public base URL used in generated links and CORS allow-list
API_BASE_URL=http://localhost:3001
# FR-IDENT-01: OTP rate-limit window in seconds
OTP_RATE_LIMIT_WINDOW_SECONDS=300
# Maximum OTP attempts per window
OTP_MAX_ATTEMPTS=5
# OTP expiry in seconds (short-lived per FR-IDENT-01)
OTP_EXPIRY_SECONDS=120

# Firebase phone ID-token audience. Public project identifier; no service-account key required.
FIREBASE_PROJECT_ID=time-bank-34a1c

# ─── Next.js Web Dashboard ───────────────────────
WEB_PORT=3000
# Must be prefixed NEXT_PUBLIC_ to be available in browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side dashboard gateway; credentials are stored in HTTP-only session cookies.
API_INTERNAL_URL=http://127.0.0.1:3001
# Set the exact public origin when deploying behind a TLS reverse proxy.
# DASHBOARD_ORIGIN=https://admin.example.org
NEXT_PUBLIC_APP_ENV=development

# ─── PostgreSQL ──────────────────────────────────
# NFR-04: Never point dev config at a prod database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ktb_dev
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ktb_dev

# Full connection string (used by TypeORM / Prisma / pg)
DATABASE_URL=postgresql://ktb_dev:change_me_dev_password@localhost:5432/ktb_dev
# Set true for a database with a trusted TLS certificate.
DATABASE_SSL=false

# ─── JWT / Session ───────────────────────────────
# FR-IDENT-01: Short-lived tokens; rotate on recovery (FR-IDENT-04)
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ─── Redis (future — for job queues and session cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Mock OTP exposes the verification code. Enable ONLY for a private disposable QA server.
AUTH_ALLOW_MOCK_OTP=false

# ─── Rate limiting (NFR-03, NFR-07, D#98) ────────────────────────────
# Global: 300 requests per minute per IP (D#98: 300 concurrent users target)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Auth/OTP endpoints use hard-coded tighter limits (10 req/min) set in controller

# ─── Matching Scheduler ──────────────────────────────────
# Controls how aggressively the matching progression worker
# sweeps for stalled requests (seconds; defaults shown).
# MATCHING_ADVANCE_CRON="0 */2 * * * *"   # every 2 min
# MATCHING_EXPIRE_CRON="0 */5 * * * *"    # every 5 min
# MATCHING_EXPIRE_GRACE_MINUTES=15        # grace after scheduled_start_time

# ─── SMS / OTP gateway ───────────────────────────
# FR-IDENT-01: OTP delivery for phone number verification.
# Set SMS_PROVIDER to select the active provider:
#   local-mock  — logs OTP to console; development only (throws in production)
#   twilio      — Twilio Programmable Messaging (recommended)
#   aws-sns     — AWS Simple Notification Service
#   msg91       — MSG91 (India-first carrier routing)
SMS_PROVIDER=local-mock

# ── Twilio (SMS_PROVIDER=twilio) ──────────────────
# Account SID and Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sender number or messaging service SID (e.g. +12015551234 or MGxxx)
SMS_FROM=+91XXXXXXXXXX

# ── AWS SNS (SMS_PROVIDER=aws-sns) ────────────────
# IAM credentials with sns:Publish permission
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Optional: 1–11 character alphanumeric sender ID shown on device (carrier support varies)
AWS_SNS_SENDER_ID=TMBK

# ── MSG91 (SMS_PROVIDER=msg91) ────────────────────
# Auth key from https://control.msg91.com/signin
MSG91_AUTH_KEY=
# OTP template ID registered in MSG91 panel (must contain {otp} variable)
MSG91_TEMPLATE_ID=

# ─── WhatsApp (optional, consent-based — FR-OFF-05) ─────
WHATSAPP_PROVIDER=meta        # meta | local-mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── File / Document Storage ─────────────────────
# NFR-08: Encrypted sensitive storage for identity documents
STORAGE_PROVIDER=local        # local | s3 | gcs
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Monitoring / Logging ────────────────────────
# NFR-06: Redact private user data from logs
LOG_LEVEL=debug               # debug | info | warn | error
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ─── Docker Compose overrides ────────────────────
# COMPOSE_PROJECT_NAME is used by docker compose to namespace containers
COMPOSE_PROJECT_NAME=ktb_dev
